# Copy to an ignored workdir's supabase/config.toml, substitute deployment URLs,
# then run config diff before config push. Undeclared hosted settings stay intact.
project_id = "matjakt"
[api]
schemas = ["public", "coop"]
extra_search_path = ["public", "extensions"]
[auth]
site_url = "LIVE_URL"
additional_redirect_urls = ["PREVIEW_URL/**"]
[auth.email]
enable_confirmations = true
