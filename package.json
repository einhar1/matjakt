{
  "name": "matjakt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:stop": "supabase stop",
    "build": "tsc -b && vite build && node scripts/write-version.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:db": "supabase test db",
    "env:local": "node scripts/local-env.mjs",
    "test": "vitest run",
    "db:reset": "supabase db reset --local",
    "db:start": "node scripts/db-start.mjs",
    "test:e2e": "playwright test",
    "deploy:course": "node scripts/deploy-course.mjs",
    "typecheck": "tsc -b",
    "rollback:course": "node scripts/rollback-course.mjs",
    "build:course": "tsc -b && vite build --mode course && node scripts/write-version.mjs",
    "bootstrap:course": "node --env-file=.env.course.local scripts/bootstrap-course.mjs"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "0.20.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "boring-avatars": "2.0.4",
    "chart.js": "4.5.1",
    "leaflet": "1.9.4",
    "mobx": "7.0.6",
    "mobx-react-lite": "5.1.0",
    "react": "19.3.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.18.4",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "supabase": "2.119.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
